# Verda 설정 파일 예시. 저장소 밖 ~/.verda/.env 로 복사해서 쓴다. (VERDA_HOME 으로 위치를 바꿀 수 있다)
# 봇(앱, 터미널), 준비 명령, 샌드박스 compose 가 모두 이 파일을 읽는다. 대상 환경의 값은 저장소에 두지 않는다.

# ---- Slack (필수) ----
# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-
# App-Level Token, connections:write 스코프 (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-
TIMEZONE=Asia/Seoul
# Socket Mode 연결 유지. 봇이 보낸 ping 에 이 시간(ms) 안에 응답이 없거나,
# Slack 의 ping 이 이 시간(ms) 동안 오지 않으면 다시 연결한다.
SOCKET_CLIENT_PING_TIMEOUT_MS=5000
SOCKET_SERVER_PING_TIMEOUT_MS=30000
# ping/pong 을 로그에 남긴다 (LOG_LEVEL=debug 일 때 보인다)
SOCKET_PING_PONG_LOG=off

# ---- 멘션 응답 ----
# 이 사용자들의 멘션에만 답한다. 쉼표 구분 Slack 사용자 ID, 비우면 모든 사용자
# (ID 확인: Slack 프로필 > 더보기 > 멤버 ID 복사)
MENTION_ALLOWED_USERS=
# 답변 시 읽기 전용으로 참고할 디렉터리 (절대 경로). codex@docker 에서는 쓰지 않는다.
MENTION_WORKSPACE=
# 동시에 실행할 CLI 수. 넘치는 요청은 최대 10건까지 대기한다.
MENTION_CONCURRENCY=2

# ---- 추론 백엔드 ----
# claude: claude -p, codex: codex exec. 둘 다 로컬 CLI 의 로그인 상태를 쓴다.
REASONER=claude
# 비우면 claude 는 claude-opus-5-5, codex 는 ~/.codex/config.toml 의 모델
REASONER_MODEL=
REASONER_TIMEOUT_SEC=300
CLAUDE_BIN=claude
CODEX_BIN=codex

# ---- 추론 샌드박스 ----
# docker: 요청마다 일회용 컨테이너에서 CLI 실행 (pnpm sandbox:build, sandbox:up 필요)
# none: 호스트에서 바로 실행
REASONER_SANDBOX=docker
# 컨테이너에는 호스트 키체인이 없어서 claude 인증 값을 따로 넣는다. (둘 중 하나)
# claude setup-token 으로 발급한 구독 토큰
SANDBOX_CLAUDE_OAUTH_TOKEN=
SANDBOX_ANTHROPIC_API_KEY=
# codex 는 로그인 파일을 읽기 전용으로 마운트한다.
SANDBOX_CODEX_AUTH_FILE=~/.codex/auth.json
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2

# ---- 운영 도구 (ops-broker) ----
# on: 추론 CLI 에 ops-broker(MCP) 를 붙인다. SSH 호스트 점검, k8s 조회, 작업 디렉터리 읽기(읽기 전용),
# 별도 작업 공간에서 코드 수정과 draft PR 생성.
# REASONER_SANDBOX=docker 와 MENTION_ALLOWED_USERS 가 필요하다. (pnpm sandbox:ops-up)
# 아래 값은 기능별로 선택이다. 비워 둔 기능은 broker 가 그 도구 없이 뜬다.
OPS_TOOLS=off
OPS_BROKER_URL=http://ops-broker:8080/mcp
# 작업 디렉터리 (fs_*, ws_*). 읽기 전용으로 마운트한다. 절대 경로
OPS_FS_ROOT=
# 코드 수정/PR 과 GitHub 조회를 허용할 조직 (ws_*, gh_*). 쉼표 구분
# 토큰은 pnpm sandbox:ops-up 이 gh auth token 으로 넘긴다.
OPS_GIT_ALLOWED_OWNERS=
# 샌드박스가 만드는 커밋의 작성자. 비우면 전역 git 설정(git config --global)을 쓴다.
# 이 저장소의 git 설정(로컬 user.name/email)과는 별개다.
OPS_GIT_AUTHOR_NAME=
OPS_GIT_AUTHOR_EMAIL=
# Jira 조회, 이슈 생성, 댓글 (jira_*). 넷 다 있어야 켜진다. 이슈와 댓글은 토큰 주인 계정으로 남고,
# 상태 변경은 하지 않는다. 토큰: id.atlassian.com > 보안 > API 토큰
OPS_JIRA_URL=
OPS_JIRA_EMAIL=
OPS_JIRA_TOKEN=
# 허용 프로젝트 키, 쉼표 구분
OPS_JIRA_PROJECTS=
# k8s 조회 (k8s_*). 로컬 kubeconfig 컨텍스트, 쉼표 구분. pnpm k8s:kubeconfig 가
# 각 클러스터의 조회 전용 ServiceAccount 토큰으로 broker 용 kubeconfig 를 만든다. (sandbox/k8s/verda-ro.yaml)
OPS_K8S_CONTEXTS=
OPS_K8S_SA=verda-ro
OPS_K8S_SA_NAMESPACE=verda
# 호스트 SSH 점검 (host_*). 사용자, 허용 대역, 키를 모두 설정해야 켜진다. 경로는 절대 경로
OPS_SSH_USER=
OPS_SSH_ALLOWED_CIDR=
OPS_SSH_KEY=
# 비우면 처음 접속한 호스트 키를 broker 안에서만 기억한다.
OPS_SSH_KNOWN_HOSTS=
# 호스트 목록: pnpm ops:prepare 가 ansible 인벤토리를 렌더링해 ~/.verda/ops-broker/hosts.json 을 만든다.
# 비우면 ~/.verda/ops-broker/hosts.json ({ "web-01": "192.168.10.11" }) 을 직접 쓴다. 인벤토리 디렉터리의 상대 경로는 이 저장소 기준
OPS_SSH_INVENTORY_DIR=
OPS_SSH_INVENTORY=

# ---- 그림 그리기 ----
# 답변의 mermaid/dot/vega-lite/svg 블록을 네트워크 없는 컨테이너에서 PNG 로 그려 올린다. (files:write)
RENDER_DIAGRAMS=on
RENDERER_IMAGE=verda-renderer:latest
# codex 생성 이미지를 올리기 전에 긴 변을 이 크기로 줄인다. 0 이면 원본
GENERATED_IMAGE_MAX_PX=512

# ---- 실행 기록, 상태, 로그 ----
# VERDA_DATA_DIR 에 실행 기록(runs/), 봇 상태(bot.json), 로그(logs/bot.log)를 남긴다. 데스크톱 앱(pnpm desktop)으로 본다.
VERDA_DATA_DIR=~/.verda
HISTORY=on
# 이보다 오래된 기록은 지운다. 0 이면 지우지 않는다.
HISTORY_RETENTION_DAYS=30

LOG_LEVEL=info
