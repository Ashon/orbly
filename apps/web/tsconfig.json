{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@history/*": [
        "../../src/history/*"
      ],
      "@runtime/*": [
        "../../src/runtime/*"
      ],
      "@src/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
