{
  "name": "@pacenote/desktop",
  "version": "0.3.2",
  "private": true,
  "description": "Pacenote desktop app: runs the bot and shows its status, logs and run history",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && PACENOTE_WEB_DEV_URL=http://127.0.0.1:5179 electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icon": "swift scripts/icon.swift ../../assets"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "electron": "39.8.10",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
  }
}
