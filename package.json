{
  "name": "orbly",
  "version": "0.2.2",
  "private": true,
  "description": "Orbly: a Slack ops bot that answers public channel mentions with local claude/codex CLIs (Socket Mode)",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests apps/*/src",
    "format": "prettier --write src tests apps/*/src apps/*/scripts",
    "format:check": "prettier --check src tests apps/*/src apps/*/scripts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:coverage": "c8 vitest run --config vitest.e2e.config.ts",
    "test:e2e:app": "pnpm desktop:build && E2E_APP=1 vitest run --config vitest.e2e.config.ts tests/e2e/app.e2e.ts",
    "check": "pnpm typecheck && pnpm --filter @pacenote/web typecheck && pnpm --filter @pacenote/desktop typecheck && pnpm lint && pnpm format:check && pnpm test",
    "sandbox:build": "tsx src/tools/sandbox-job.ts images",
    "sandbox:up": "tsx src/tools/sandbox-job.ts proxy",
    "sandbox:down": "docker compose -f sandbox/compose.yaml down",
    "slack:check": "tsx src/tools/check-slack.ts",
    "k8s:kubeconfig": "tsx src/tools/sandbox-job.ts kubeconfig",
    "sandbox:ops-up": "pnpm bundle && tsx src/tools/sandbox-job.ts broker",
    "desktop:build": "pnpm build && pnpm bundle && pnpm --filter @pacenote/web build && pnpm --filter @pacenote/desktop build",
    "desktop": "pnpm desktop:build && pnpm --filter @pacenote/desktop start",
    "desktop:dev": "pnpm --filter @pacenote/web dev & pnpm --filter @pacenote/desktop dev",
    "package:mac": "pnpm desktop:build && node apps/desktop/scripts/package-mac.mjs",
    "install:mac": "node apps/desktop/scripts/install-mac.mjs",
    "hub": "tsx src/hub/index.ts",
    "hub:image": "pnpm bundle && docker build -t orbly-hub:latest deploy/hub"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.2.0",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@slack/types": "^3.2.0",
    "@types/node": "^24.19.1",
    "@types/ws": "8.18.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
